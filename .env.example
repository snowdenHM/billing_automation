# ==== Django Core ====
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
TIME_ZONE=Asia/Kolkata

# Hosts (no ports here)
ALLOWED_HOSTS=billmunshi.com,www.billmunshi.com,127.0.0.1,localhost,34.51.42.227

# ==== Database ====
# NOTE: '@' in password is URL-encoded as %40
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5432/billmunshi

# ==== Cache / Redis ====
REDIS_URL=redis://127.0.0.1:6379/1

# ==== CORS / CSRF ====
# Add your real frontend origins here
CORS_ALLOWED_ORIGINS=https://billmunshi.com,https://www.billmunshi.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Django 4+ requires scheme in CSRF_TRUSTED_ORIGINS
CSRF_TRUSTED_ORIGINS=https://billmunshi.com,https://www.billmunshi.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# If you terminate TLS at Nginx, tell Django to trust X-Forwarded-Proto
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ==== Email (SendGrid via django-anymail) ====
# When SENDGRID_API_KEY is set, the backend automatically switches to the
# anymail SendGrid backend. Leave empty in dev to fall back to the
# console backend (emails print to stdout).
SENDGRID_API_KEY=
# EMAIL_BACKEND overrides the auto-selection above if you need it.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Bill Munshi <support@billmunshi.com>
SERVER_EMAIL=Bill Munshi <support@billmunshi.com>
# Public URL of the frontend — used to build links in emails (reset,
# verify). Must NOT include a trailing slash.
FRONTEND_URL=http://localhost:5173

# ==== OpenAI (bill OCR / analysis) ====
OPENAI_API_KEY=

# ==== Logging ====
DJANGO_LOG_LEVEL=INFO
